# The connection string to your Azure AI Foundry Project
# Format: <endpoint>;<subscription_id>;<resource_group>;<project_name>
PROJECT_CONNECTION_STRING="your_project_connection_string_here"

# Workspace and Semantic Model IDs for the agent to target by default
FABRIC_WORKSPACE_ID="your_workspace_guid"
FABRIC_SEMANTIC_MODEL_ID="your_dataset_guid"